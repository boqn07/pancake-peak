local L = require("./Loader")
return function(T)
	local Schema = L.get("Shared/Logic/Schema")
	local Inventory = L.get("Shared/Logic/Inventory")
	local Daily = L.get("Shared/Logic/Daily")
	local Codes = L.get("Shared/Logic/Codes")
	local Receipts = L.get("Shared/Logic/Receipts")
	local Boosts = L.get("Shared/Logic/Boosts")
	local RewardGrant = L.get("Shared/Logic/RewardGrant")
	local Economy = L.get("Shared/Logic/Economy")
	local RateLimiter = L.get("Shared/Logic/RateLimiter")
	local Spring = L.get("Shared/Logic/Spring")
	local Game = L.get("Shared/Config/Game")
	local Monet = L.get("Shared/Config/Monetization")

	T.describe("Schema", function()
		T.it("new profiles get defaults", function()
			local p, ok = Schema.migrate(nil)
			T.expect(ok).toBeTruthy()
			T.expect(p.version).toBe(Schema.VERSION)
			T.expect(p.zones.MapleMeadow).toBe(true)
			T.expect(p.stats.tallest).toBe(0)
		end)
		T.it("runs migrations in order and reconciles new keys", function()
			-- A sample v1 -> v2 step: Maple was once stored as `coins`.
			local migrations = {
				function(data)
					data.maple = data.coins
					data.coins = nil
					return data
				end,
			}
			local old = { version = 1, coins = 500, rebirths = 2 }
			local p, ok = Schema.migrateWith(old, migrations, 2)
			T.expect(ok).toBeTruthy()
			T.expect(p.version).toBe(2)
			T.expect(p.maple).toBe(500)
			T.expect(p.coins).toBe(nil)
			T.expect(p.rebirths).toBe(2)
			T.expect(p.upgrades.Batter).toBe(0)
			T.expect(p.perks.GoldenSyrup).toBe(0)
		end)
		T.it("refuses a missing migration step", function()
			local _, ok = Schema.migrateWith({ version = 1 }, {}, 3)
			T.expect(ok).toBeFalsy()
		end)
		T.it("refuses data from a newer version instead of clobbering it", function()
			local _, ok, err = Schema.migrate({ version = 999 })
			T.expect(ok).toBeFalsy()
			T.expect(type(err)).toBe("string")
		end)
		T.it("refuses non-table data", function()
			local _, ok = Schema.migrate("garbage")
			T.expect(ok).toBeFalsy()
		end)
		T.it("sanitizes corrupt values", function()
			local p = Schema.default()
			p.maple = 0 / 0
			p.upgrades.Batter = 9999
			p.perks.ExtraPocket = 50
			p.spatulas = -5
			p.lifetimeMaple = math.huge
			p.nibblers["1"] = { id = "NotANibbler" }
			p.nibblers["7"] = { id = "Pip" }
			p.equipped = { "1", "7", "7", "nope", 5 }
			p.zones.MapleMeadow = nil
			p.zones.Moon = true
			p.nextUid = 2
			Schema.sanitize(p)
			T.expect(p.maple).toBe(0)
			T.expect(p.upgrades.Batter).toBe(100)
			T.expect(p.perks.ExtraPocket).toBe(2)
			T.expect(p.spatulas).toBe(0)
			T.expect(p.lifetimeMaple).toBe(0)
			T.expect(p.nibblers["1"]).toBe(nil)
			T.expect(#p.equipped).toBe(1)
			T.expect(p.zones.MapleMeadow).toBe(true)
			T.expect(p.zones.Moon).toBe(nil)
			T.expect(p.nextUid).toBe(8)
		end)
		T.it("repairs a wrongly typed nested table", function()
			local p = Schema.default()
			p.stats = "oops"
			local fixed, ok = Schema.migrate(p)
			T.expect(ok).toBeTruthy()
			T.expect(fixed.stats.tallest).toBe(0)
		end)
	end)

	T.describe("Inventory", function()
		T.it("equip respects slots and duplicates", function()
			local p = Schema.default()
			local a = Inventory.add(p, "Pip", false, 0)
			local b = Inventory.add(p, "Muffin", false, 0)
			T.expect((Inventory.equip(p, a, 1))).toBeTruthy()
			T.expect((Inventory.equip(p, a, 1))).toBeFalsy()
			T.expect((Inventory.equip(p, b, 1))).toBeFalsy()
			T.expect((Inventory.equip(p, "999", 5))).toBeFalsy()
			T.expect((Inventory.unequip(p, a))).toBeTruthy()
			T.expect((Inventory.unequip(p, a))).toBeFalsy()
		end)
		T.it("equipBest picks the strongest", function()
			local p = Schema.default()
			Inventory.add(p, "Pip", false, 0)
			local best = Inventory.add(p, "AuroraYeti", false, 0)
			local second = Inventory.add(p, "Pip", true, 0)
			Inventory.equipBest(p, 2)
			T.expect(p.equipped[1]).toBe(best)
			T.expect(p.equipped[2]).toBe(second)
		end)
		T.it("release removes and unequips", function()
			local p = Schema.default()
			local a = Inventory.add(p, "Pip", false, 0)
			Inventory.equip(p, a, 3)
			T.expect((Inventory.release(p, a))).toBeTruthy()
			T.expect(#p.equipped).toBe(0)
			T.expect(Inventory.count(p)).toBe(0)
			T.expect((Inventory.release(p, a))).toBeFalsy()
		end)
		T.it("capacity", function()
			local p = Schema.default()
			for _ = 1, Game.InventoryCap do
				Inventory.add(p, "Pip", false, 0)
			end
			T.expect(Inventory.hasRoom(p, 1)).toBeFalsy()
		end)
	end)

	T.describe("Daily", function()
		local DAY = 86400
		T.it("claims once per day and builds a streak", function()
			local s = { streak = 0, lastDay = -1 }
			T.expect(Daily.claim(s, DAY * 100 + 5, 7)).toBe(1)
			T.expect(Daily.claim(s, DAY * 100 + 500, 7)).toBe(nil)
			T.expect(Daily.claim(s, DAY * 101 + 5, 7)).toBe(2)
			T.expect(s.streak).toBe(2)
		end)
		T.it("missing a day resets the streak", function()
			local s = { streak = 5, lastDay = 100 }
			local can, day, resets = Daily.status(s, DAY * 102, 7)
			T.expect(can).toBeTruthy()
			T.expect(day).toBe(1)
			T.expect(resets).toBeTruthy()
		end)
		T.it("wraps after 7 days", function()
			local s = { streak = 7, lastDay = 100 }
			T.expect(Daily.claim(s, DAY * 101, 7)).toBe(1)
			T.expect(s.streak).toBe(8)
		end)
	end)

	T.describe("Codes", function()
		T.it("normalizes, validates, expires, and is single-use", function()
			local p = Schema.default()
			local ok, code = Codes.check(p, " launch ", 0)
			T.expect(ok).toBeTruthy()
			T.expect(code).toBe("LAUNCH")
			p.codes.LAUNCH = true
			T.expect((Codes.check(p, "LAUNCH", 0))).toBeFalsy()
			T.expect((Codes.check(p, "nope", 0))).toBeFalsy()
			T.expect((Codes.check(p, 5, 0))).toBeFalsy()
			T.expect((Codes.check(p, string.rep("A", 500), 0))).toBeFalsy()
			T.expect((Codes.check(p, "CRUMBS", 1830297600 + 1))).toBeFalsy()
		end)
	end)

	T.describe("Receipts and boosts", function()
		T.it("remembers purchase ids, bounded", function()
			local p = Schema.default()
			Receipts.record(p, "a")
			T.expect(Receipts.seen(p, "a")).toBeTruthy()
			T.expect(Receipts.seen(p, "b")).toBeFalsy()
			for i = 1, Game.ReceiptHistorySize + 10 do
				Receipts.record(p, "x" .. i)
			end
			T.expect(#p.receipts).toBe(Game.ReceiptHistorySize)
			T.expect(Receipts.seen(p, "a")).toBeFalsy()
		end)
		T.it("boosts stack, cap and tick down", function()
			local p = Schema.default()
			Boosts.add(p, "Maple2x", 100)
			Boosts.add(p, "Maple2x", 100)
			T.expect(p.boosts.Maple2x).toBe(200)
			Boosts.add(p, "Maple2x", 1e9)
			T.expect(p.boosts.Maple2x).toBe(Monet.MaxBoostSeconds)
			Boosts.add(p, "Lucky", -50)
			T.expect(p.boosts.Lucky).toBe(0)
			p.boosts.Maple2x = 1
			T.expect(Boosts.tick(p, 2)).toBeTruthy()
			T.expect(p.boosts.Maple2x).toBe(0)
		end)
	end)

	T.describe("RewardGrant", function()
		local ctx = Economy.emptyContext()
		T.it("grants maple, boosts and nibblers", function()
			local p = Schema.default()
			local r = RewardGrant.apply(p, { kind = "Maple", minutes = 1, min = 50 }, ctx, T.rng(1), 0)
			T.expect(r.amount).toBeGreaterThan(49)
			T.expect(p.maple).toBe(r.amount)
			T.expect(p.lifetimeMaple).toBe(r.amount)
			RewardGrant.apply(p, { kind = "Boost", boost = "Lucky", seconds = 60 }, ctx, T.rng(1), 0)
			T.expect(p.boosts.Lucky).toBe(60)
			local g = RewardGrant.apply(p, { kind = "Nibbler", minRarity = "Rare" }, ctx, T.rng(3), 0)
			T.expect(g.kind).toBe("Nibbler")
			T.expect(p.nibblers[g.uid] ~= nil).toBeTruthy()
			local rarity = L.get("Shared/Config/Nibblers").ById[g.nibbler].rarity
			T.expect(L.get("Shared/Config/Rarities").ById[rarity].rank >= 3).toBeTruthy()
		end)
		T.it("converts a nibbler reward to maple when the inventory is full", function()
			local p = Schema.default()
			for _ = 1, Game.InventoryCap do
				Inventory.add(p, "Pip", false, 0)
			end
			local g = RewardGrant.apply(p, { kind = "Nibbler", minRarity = "Rare" }, ctx, T.rng(3), 0)
			T.expect(g.kind).toBe("Maple")
		end)
	end)

	T.describe("RateLimiter", function()
		T.it("allows bursts then refills over time", function()
			local now = 0
			local rl = RateLimiter.new({ Buy = { rate = 2, burst = 3 } }, function()
				return now
			end)
			T.expect(rl:allow("p", "Buy")).toBeTruthy()
			T.expect(rl:allow("p", "Buy")).toBeTruthy()
			T.expect(rl:allow("p", "Buy")).toBeTruthy()
			T.expect(rl:allow("p", "Buy")).toBeFalsy()
			now = 0.5
			T.expect(rl:allow("p", "Buy")).toBeTruthy()
			T.expect(rl:allow("p", "Buy")).toBeFalsy()
			T.expect(rl:allow("q", "Buy")).toBeTruthy()
			T.expect(rl:allow("p", "Unknown")).toBeFalsy()
			rl:forget("p")
			T.expect(rl:allow("p", "Buy")).toBeTruthy()
		end)
	end)

	T.describe("Spring", function()
		T.it("settles at the target", function()
			local s = Spring.new(0, 20, 0.8)
			s.target = 10
			for _ = 1, 120 do
				Spring.step(s, 1 / 60)
			end
			T.expect(s.position).toBeNear(10, 0.01)
			T.expect(Spring.isResting(s, 0.05)).toBeTruthy()
		end)
		T.it("stays stable with a huge dt", function()
			local s = Spring.new(0, 30, 0.5)
			s.target = 1
			Spring.step(s, 2)
			T.expect(s.position == s.position).toBeTruthy()
			T.expect(math.abs(s.position)).toBeLessThan(10)
		end)
	end)
end
