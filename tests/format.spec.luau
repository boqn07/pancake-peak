local L = require("./Loader")
return function(T)
	local Format = L.get("Shared/Logic/Format")
	T.describe("Format.abbreviate", function()
		T.it("keeps small numbers", function()
			T.expect(Format.abbreviate(0)).toBe("0")
			T.expect(Format.abbreviate(999)).toBe("999")
			T.expect(Format.abbreviate(12.75)).toBe("12.7")
		end)
		T.it("abbreviates with 3 significant digits and never rounds up", function()
			T.expect(Format.abbreviate(1000)).toBe("1K")
			T.expect(Format.abbreviate(1234)).toBe("1.23K")
			T.expect(Format.abbreviate(15_300_000)).toBe("15.3M")
			T.expect(Format.abbreviate(999_999)).toBe("999K")
			T.expect(Format.abbreviate(2.5e12)).toBe("2.5T")
			T.expect(Format.abbreviate(1e15)).toBe("1Qa")
			T.expect(Format.abbreviate(4.56e33)).toBe("4.56Dc")
		end)
		T.it("handles NaN, infinity, negatives and huge values", function()
			T.expect(Format.abbreviate(0 / 0)).toBe("0")
			T.expect(Format.abbreviate(math.huge)).toBe("∞")
			T.expect(Format.abbreviate(-1500)).toBe("-1.5K")
			T.expect(string.find(Format.abbreviate(1e300), "e") ~= nil).toBeTruthy()
		end)
	end)
	T.describe("Format misc", function()
		T.it("commas", function()
			T.expect(Format.commas(1234567)).toBe("1,234,567")
			T.expect(Format.commas(100)).toBe("100")
		end)
		T.it("clock", function()
			T.expect(Format.clock(125)).toBe("2:05")
			T.expect(Format.clock(3725)).toBe("1:02:05")
			T.expect(Format.clock(-5)).toBe("0:00")
		end)
		T.it("percent", function()
			T.expect(Format.percent(0.55)).toBe("55%")
			T.expect(Format.percent(0.009)).toBe("0.9%")
			T.expect(Format.percent(0.001)).toBe("0.1%")
			T.expect(Format.percent(0.00001)).toBe("1 in 100,000")
		end)
	end)
end
